# MAGI System — AI API Keys
# Copy this file to .env.local and fill in your API keys

# OpenAI API Key (for MELCHIOR-1)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# GPT model name (optional, default: gpt-6-luna)
OPENAI_MODEL=gpt-6-luna
# GPT reasoning effort: low, medium, or high (default: low)
OPENAI_REASONING_EFFORT=low

# Anthropic API Key (for BALTHASAR-2)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model name (optional, default: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Claude Sonnet 5.5 reasoning effort: low, medium, or high (default: low)
ANTHROPIC_EFFORT=low

# Google AI API Key (for CASPER-3)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Model name (optional, default: gemini-3.8-flash)
GOOGLE_MODEL=gemini-3.8-flash
# Gemini thinking level: low, medium, or high (default: low)
GOOGLE_THINKING_LEVEL=low
